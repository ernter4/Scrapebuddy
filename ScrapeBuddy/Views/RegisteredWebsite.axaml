        <StreamGeometry x:Key="edit_regular">M27.3138 4.68622C28.8759 6.24832 28.8759 8.78098 27.3138 10.3431L12.5409 25.116C11.9001 25.7568 11.0972 26.2114 10.218 26.4312L5.63602 27.5767C4.90364 27.7598 4.24025 27.0964 4.42335 26.364L5.56885 21.782C5.78864 20.9028 6.24323 20.0999 6.88402 19.4591L21.6569 4.68622C23.219 3.12412 25.7517 3.12412 27.3138 4.68622ZM20.2426 8.92865L8.29824 20.8734C7.91376 21.2578 7.641 21.7396 7.50913 22.2671L6.76786 25.2322L9.73295 24.4909C10.2604 24.359 10.7422 24.0863 11.1267 23.7018L23.0706 11.7566L20.2426 8.92865ZM23.0712 6.10043L21.6566 7.51465L24.4846 10.3426L25.8996 8.92886C26.6806 8.14781 26.6806 6.88148 25.8996 6.10043C25.1185 5.31939 23.8522 5.31939 23.0712 6.10043Z</StreamGeometry>
    </UserControl.Resources>
    
    <UserControl.Styles>
        <Style Selector="ToggleButton PathIcon.audio-on">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ToggleButton:checked PathIcon.audio-on">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="ToggleButton PathIcon.audio-mute">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="ToggleButton:checked PathIcon.audio-mute">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        
        <Style Selector="Button.ToggleButton">
            <Setter Property="Background" Value="#f5f7fa"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1.2"/>    
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="-1,0,-1,0"/>
        </Style>

        <Style Selector="Button.ToggleButton:pressed">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#007ACC"/>
        </Style>

        <Style Selector="Button.LeftToggle">
            <Setter Property="CornerRadius" Value="15,0,0,15"/>
        </Style>
    
        <Style Selector="Button.RightToggle">
            <Setter Property="CornerRadius" Value="0,15,15,0"/>
        </Style>
    </UserControl.Styles>
    
    <Grid RowDefinitions="Auto, Auto, Auto">
        <!-- cancel and info -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Background="Aqua">
            <Button Grid.Column="0" IsCancel="True" Click="OnCancelView" Height="35">
                <Path Data="{StaticResource home_regular}" Fill="Black" Stretch="Uniform"></Path>
            </Button>
            <ToggleButton x:Name="EditBtn" Grid.Column="2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="ClearAllFields" Height="35">
                <Panel>
                    <PathIcon Classes="audio-on" Data="{StaticResource edit_off_regular}"></PathIcon>
                    <PathIcon Classes="audio-mute" Data="{StaticResource edit_regular}"></PathIcon>
                </Panel>
            </ToggleButton>
        </Grid>
        
        <!-- Website -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto,*,Auto,*,Auto,*,Auto,*,Auto,*" ColumnDefinitions="*,Auto,*" Background="PaleGreen">
            <TextBox Grid.Column="1" Grid.Row="1" Watermark="Website Name" x:Name="WebsiteNameTextBox" IsEnabled="{Binding IsEditable}" Width="200" Height="20" VerticalContentAlignment="Center" Margin="0,20,0,0"/>
            <TextBox Grid.Column="1" Grid.Row="3" Watermark="Website Link" x:Name="WebsiteLinkTextBox" IsEnabled="{Binding IsEditable}" Width="200" Height="20" VerticalContentAlignment="Center" Margin="0,20,0,10"/>
            <StackPanel Grid.Column="1" Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,15,0,0">
                <Button x:Name="IdButton" Content="ID" Click="OnIDClicked"
                        Classes="ToggleButton LeftToggle" />
                <Button x:Name="XPathButton" Content="XPath" Click="OnXPathClicked"
                        Classes="ToggleButton RightToggle" />
            </StackPanel>
            <TextBox Grid.Column="1" Grid.Row="7" x:Name="PathToElementTextBox" Watermark="Id" Width="200" Height="20" VerticalContentAlignment="Center" IsEnabled="{Binding IsEditable}" Margin="0,5,0,5"/>
            <Grid Grid.Column="1" Grid.Row="9" DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" IsVisible="{Binding NeedsCredentials}" Margin="0,10,0,30">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Credentials"/>
                <TextBox Grid.Row="1" Grid.Column="0" x:Name="UsernameTextBox" Watermark="Username" IsEnabled="{Binding IsEditable}"></TextBox>
                <TextBox Grid.Row="1" Grid.Column="2" x:Name="PasswordTextBox" Watermark="Password" IsEnabled="{Binding IsEditable}" Classes="revealPasswordButton" PasswordChar="*"></TextBox>
            </Grid>
        </Grid>
        
        <!-- scrape and save -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*,Auto,*" Background="Aqua">
            <Button x:Name="ScrapeBtn" Grid.Column="1" Content="Scrape" Click="PrintAllVariables">
            </Button>
            <StackPanel Grid.Column="3">
                <Button x:Name="SaveBtn"  Content="Save" Command="{Binding WriteUserInputsToDatabase}" />
                <ToolTip.Tip>
                    <TextBlock>Conditions for content to be savable</TextBlock>
                </ToolTip.Tip>
            </StackPanel>
            
        </Grid>
    </Grid>
    
</UserControl>