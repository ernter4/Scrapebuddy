<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignWidth="830" d:DesignHeight="720"
             x:Class="ScrapeBuddy.ViewModels.SettingsViewModel">
    <UserControl.Resources>
        <StreamGeometry x:Key="home_regular">M21.6062 5.85517C23.0048 4.71494 24.9952 4.71494 26.3938 5.85517L39.5688 16.5966C40.4736 17.3342 41 18.4492 41 19.628V39.1134C41 41.2599 39.2875 43 37.175 43H32.075C29.9625 43 28.25 41.2599 28.25 39.1134V29.7492C28.25 29.0337 27.6792 28.4536 26.975 28.4536H21.025C20.3208 28.4536 19.75 29.0337 19.75 29.7492V39.1134C19.75 41.2599 18.0375 43 15.925 43H10.825C8.71251 43 7 41.2599 7 39.1134V19.628C7 18.4493 7.52645 17.3342 8.43124 16.5966L21.6062 5.85517ZM24.7979 7.87612C24.3317 7.49604 23.6683 7.49604 23.2021 7.87612L10.0271 18.6175C9.72548 18.8634 9.55 19.2351 9.55 19.628V39.1134C9.55 39.8289 10.1208 40.4089 10.825 40.4089H15.925C16.6292 40.4089 17.2 39.8289 17.2 39.1134V29.7492C17.2 27.6027 18.9125 25.8626 21.025 25.8626H26.975C29.0875 25.8626 30.8 27.6027 30.8 29.7492V39.1134C30.8 39.8289 31.3708 40.4089 32.075 40.4089H37.175C37.8792 40.4089 38.45 39.8289 38.45 39.1134V19.628C38.45 19.2351 38.2745 18.8634 37.9729 18.6175L24.7979 7.87612Z</StreamGeometry>
    </UserControl.Resources>
    
    <UserControl.Styles>
        <StyleInclude Source="../AppStyles.axaml"></StyleInclude>
    </UserControl.Styles>
    
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Header Row -->
            <RowDefinition Height="Auto" />  <!-- Title Row -->
            <RowDefinition Height="*" />     <!-- Content Row -->
            <RowDefinition Height="Auto" />  <!-- Footer Row -->
        </Grid.RowDefinitions>

        <!-- Header with Home Button -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
            <Button Grid.Column="0" IsCancel="True" x:Name="Home" Click="OnCancelView" Height="35" Margin="5">
                <Path Data="{StaticResource home_regular}" Stretch="Uniform" />
            </Button>
        </Grid>

        <!-- Centered Title -->
        <Grid Grid.Row="1">
            <TextBlock 
                x:Name="Title"
                Text="Settings" 
                FontSize="38" 
                FontWeight="Bold"
                Foreground="White"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Margin="0,0,0,10"/>  <!-- Adjust margin as needed -->
        </Grid>

        <!-- Main Content -->
        <StackPanel Grid.Row="2" Margin="10" HorizontalAlignment="Center">
            <!-- Toggle for Dark/White Mode -->
            <ToggleSwitch x:Name="DarkModeToggleSwitch" FontSize="20" Content="Dark Mode" IsChecked="False" Click="OnToggleDarkWhiteMode" Margin="0,40, 0 ,10" />
        
            <!-- Toggle for Email Notifications -->
            <ToggleSwitch x:Name="EmailNotificationsToggleSwitch" FontSize="20" Content="Enable Email Notifications" IsChecked="False" Click="OnToggleEmailNotifications" Margin="0,40, 0 ,10" />

            <StackPanel x:Name="EmailSettingsPanel" IsVisible="False" Margin="0,10">
                <TextBox x:Name="EmailTextBox" FontSize="16" Watermark="Enter Email" Width="200" Margin="0,10" TextChanged="OnEmailTextBoxTextChanged"/>
                <TextBox x:Name="NameTextBox" FontSize="16" Watermark="Enter Name" Width="200" Margin="0,10" TextChanged="OnNameTextBoxTextChanged"/>
                <Button x:Name="SaveButton" Content="Save" HorizontalAlignment="Center" Click="OnSaveEmailSettings" Margin="0,10" Width="100" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>

        <!-- Footer with Buttons -->
        <Grid Grid.Row="3" Margin="10, 10 ,10 ,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />  <!-- Space on the left -->
                <ColumnDefinition Width="Auto" /> <!-- Button 1 -->
                <ColumnDefinition Width="*" />  <!-- Space between buttons -->
                <ColumnDefinition Width="Auto" /> <!-- Button 2 -->
                <ColumnDefinition Width="*" />  <!-- Space on the right -->
            </Grid.ColumnDefinitions>

            <!-- Button 1 -->
            <Button Grid.Column="1" x:Name="DeleteDatabase" FontSize="16" Content="Delete Database" Click="OnDeleteDatabase" HorizontalAlignment="Center" Width="170" Height="40" />

            <!-- Button 2 -->
            <Button Grid.Column="3" x:Name="ResetPassphrase" FontSize="16" Content="Reset Passphrase" Click="OnResetPassphrase" HorizontalAlignment="Center" Width="170" Height="40" />
        </Grid>
    </Grid>

    

</UserControl>