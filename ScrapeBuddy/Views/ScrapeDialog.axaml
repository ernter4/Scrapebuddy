<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScrapeBuddy.ViewModels.ScrapeDialog"
        Title="Processing" Width="400" Height="200"
        Icon="avares://ScrapeBuddy/Assets/logo.ico">
        
        <Window.Styles>
                <StyleInclude Source="../AppStyles.axaml"></StyleInclude>
        </Window.Styles>
        <Grid  x:Name="MainGrid">
                <DockPanel LastChildFill="True" Margin="20">
                        <!-- TextBlock for showing the status message -->
                        <TextBlock x:Name="Text" FontSize="16" HorizontalAlignment="Center" TextWrapping="Wrap" DockPanel.Dock="Top" Margin="10"/>
        
                        <!-- ProgressBar for loading indication -->
                        <ProgressBar Name="LoadingProgressBar" IsIndeterminate="True" Height="20" Margin="10" DockPanel.Dock="Top" Foreground="#586A77"/>
        
                        <!-- Button for confirming actions, docked at the bottom-center -->
                        <Button x:Name="OkayButton" Name="OkButton" Content="OK" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="10" IsVisible="False" Click="OnOkClick" DockPanel.Dock="Bottom"/>
                </DockPanel>
        </Grid>
</Window>