<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ScrapeBuddy.ViewModels.LoadingWindow"
        Title="ScrapeBuddy"
        Width="400" Height="400"
        Icon="avares://ScrapeBuddy/Assets/logo.ico"
        >
    <Window.Styles>
        <StyleInclude Source="../AppStyles.axaml"></StyleInclude>
    </Window.Styles>
    <Grid>

        <!-- Main Content -->

        <StackPanel Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="/Assets/logo.ico" Width="100" Height="100" RenderOptions.BitmapInterpolationMode="HighQuality"/>
            <TextBlock Name="Block" Text="ScrapeBuddy" FontSize="38"  FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ProgressBar Name="ProgressBar1" MaxWidth="250" Height="20" BorderBrush="#416788" Foreground="#81D2C7" BorderThickness="2" Margin="0 10 0 0"/>
            <TextBlock Text="Loading..." Name="LoadingText" HorizontalAlignment="Center" FontSize="20" Foreground="#B5BAD0"/>
        </StackPanel>

    </Grid>
</Window>