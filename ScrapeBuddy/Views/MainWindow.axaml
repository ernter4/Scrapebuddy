    </Window.Resources>
    
    
    <Grid> 
        
        <!-- Linke Spalte -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/> <!-- Breite der linken Spalte -->
            <ColumnDefinition Width="*"/> <!-- Hauptinhalt -->  
        </Grid.ColumnDefinitions>
        

        <!-- Linke Seitenleiste -->
        <DockPanel Grid.Column="0"  Background="Orange">
            <!-- Benachrichtigungssymbole oben -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10" Background="Beige">
                <Button Margin="5" Height="30">
                    <Path Data="{StaticResource channel_notifications_regular}" Fill="Gold" Margin="5" ></Path>
                </Button>
                <Button Margin="5" Height="30">
                    <Path Data="{StaticResource settings_regular}" Fill="Gray" Stretch="Uniform"></Path>
                </Button>
            </StackPanel>
            
            <!-- Logo und Schaltflächen -->
            <StackPanel DockPanel.Dock="Top" Margin="10" Background="Aqua" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="ScrapeBuddy"
                           FontWeight="Bold" 
                           FontSize="30" 
                           Margin="0,20,0,20"   
                           TextAlignment="Center"/>
                <Button x:Name="CreateNewBtn" Content="+ create new" Width="200" Height="40" FontWeight="Heavy" Margin="0,10,0,10" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <TextBox Watermark=" Search" x:Name="SearchTextBox" Width="200" Height="40" VerticalContentAlignment="Center"/>
            </StackPanel>

            <!-- Registered Websites -->
            <ScrollViewer DockPanel.Dock="Bottom" Margin="10" Background="Blue">
                <ListBox x:Name="RegisteredWebsiteListBox" ItemsSource="{Binding StoredUserWebsites}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding WebsiteName}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Height="35" Width="20" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="Transparent">
                                    <Path Data="{StaticResource more_vertical_regular}" Fill="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="UniformToFill"/>
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <!--
                                            <Grid ColumnDefinitions="Auto,Auto">
                                                
                                            </Grid> -->
                                            
                                            <MenuItem Click="RenderDeleteWebsiteView" Tag="{Binding}">
                                                <MenuItem.Header>
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <Path Grid.Column="0" Data="{StaticResource delete_regular}" Height="25" Fill="Black" Stretch="Uniform"/>
                                                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,0,0,0">Delete</TextBlock>
                                                    </Grid>
                                                </MenuItem.Header>
                                            </MenuItem> 
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button> 
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </DockPanel>

        
        <StackPanel Grid.Column="1" x:Name="MainContent">
            <!-- dynamically load content in here -->
        </StackPanel>
    </Grid> 

    
    
     
</Window>