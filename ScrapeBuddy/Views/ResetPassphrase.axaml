<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScrapeBuddy.ResetPassphraseWindow"
        Title="Reset Passphrase"
        Width="300"
        Height="150">
    <StackPanel Margin="10">
        <TextBlock Text="Are you sure you want to reset your password? This will delete all your scraping data and cannot be undone."
                   TextWrapping="Wrap" Margin="0,0,0,50"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="YesButton" Content="Yes" Width="70" Background="Green" Margin="0,0,10,0"/>
            <Button x:Name="NoButton" Content="No" Background="Red" Width="70"/>
        </StackPanel>
    </StackPanel>
</Window>
