<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScrapeBuddy.ViewModels.LoginWindow"
        Title="Login"
        Width="500" Height="500">
    <Window.Styles>
        <StyleInclude Source="../AppStyles.axaml"></StyleInclude>
    </Window.Styles>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="200"> 
        <TextBlock Text="Enter Password:" Margin="0,0,0,10" />
        <TextBox x:Name="PasswordBox" Classes="revealPasswordButton" PasswordChar="*" Watermark="Enter your password" Width="200" TextChanged="PasswordBox_TextChanged"/>
        <Button Content="Login" Width="200" Margin="0,10,0,0" Click="OnLoginClick" HorizontalAlignment="Center"/>
        <StackPanel Width="300" HorizontalAlignment="Center"><TextBlock x:Name="ErrorTextBlock"  FontSize="12" Foreground="Red" Margin="0,10,0,0" IsVisible="False" HorizontalAlignment="Center"/></StackPanel>
        <Button Click="ForgotPasswordClick" Background="Transparent" BorderThickness="0" Margin="0,40,0,0" HorizontalAlignment="Right">
            <Button.Styles>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Azure"></Setter>
                </Style>
            </Button.Styles> 
            <TextBlock Text="Forgot Passphrase" Foreground="DodgerBlue"  FontSize="12"/>
        </Button> 
    </StackPanel>
</Window>
