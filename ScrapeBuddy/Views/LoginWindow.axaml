<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScrapeBuddy.ViewModels.LoginWindow"
        Title="Login"
        Width="400" Height="400"
        Icon="avares://ScrapeBuddy/Assets/logo.ico">
  <Window.Styles>
        <StyleInclude Source="../AppStyles.axaml"></StyleInclude>
    </Window.Styles>

    <Grid>

        <!-- Main Content -->

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                <!-- Header with Icon -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
                    <TextBlock Name="Welcome" Text="Welcome Back!" FontSize="26" FontWeight="Bold" Foreground="#416788" HorizontalAlignment="Center"/>
                    <Image Source="/Assets/logo.ico" Width="100" Height="100" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                </StackPanel>
                
                <!-- Password Input -->
                <TextBlock Name="Enter" Text="Enter your Passphrase:" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#416788" />
                <Border Background="#E0E0E2" CornerRadius="8" >
                    <TextBox x:Name="PasswordBox" Classes="revealPasswordButton" PasswordChar="•" Watermark="Passphrase" Width="250"  Background="#E0E0E2" Foreground="#416788" TextChanged="PasswordBox_TextChanged" HorizontalAlignment="Center"/>
                </Border>

                <StackPanel Margin="0,10,0,0 ">
                    <!-- Login Button -->
                    <Button Name="LoginButton" Content="Login" Width="150" Height="30" Click="OnLoginClick" HorizontalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                    <!-- Error Text -->
                    <TextBlock x:Name="ErrorTextBlock" FontSize="12" Foreground="Red" Margin="0,5,0,0" IsVisible="False" HorizontalAlignment="Center"/>

                    <!-- Forgot Password -->
                    <Button Margin="0,10,0,0" Click="ForgotPasswordClick" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right">
                        <TextBlock Name="Forgot" Text="Forgot Passphrase?" Foreground="#416788" FontSize="12" TextDecorations="Underline"/>
                    </Button>
                </StackPanel>
                
            </StackPanel>

    </Grid>
</Window>
