<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScrapeBuddy.LoginWindow"
        Title="Login"
        Width="500" Height="500">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Enter Password:" Margin="0,0,0,10"/>
        <TextBox x:Name="PasswordBox" Classes="revealPasswordButton" PasswordChar="*" Watermark="Enter your password" Width="200"/>
        <Button Content="Login" Width="200" Margin="0,10,0,0" Click="OnLoginClick"/>
        <TextBlock x:Name="ErrorTextBlock" Foreground="Red" Margin="0,10,0,0"/>
    </StackPanel>
</Window>