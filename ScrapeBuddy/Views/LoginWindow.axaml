<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScrapeBuddy.ViewModels.LoginWindow"
        Title="Login"
        Width="400" Height="400"
        Icon="avares://ScrapeBuddy/Assets/logo.ico">
  <Window.Styles>
        <StyleInclude Source="../AppStyles.axaml"></StyleInclude>
    </Window.Styles>

    <Grid>

        <!-- Main Content -->

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                <!-- Header with Icon -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                    <TextBlock Name="Welcome" Text="Welcome Back!" FontSize="26" FontWeight="Bold" Foreground="#416788" HorizontalAlignment="Center"/>
                    <Image Source="/Assets/logo.ico" Width="100" Height="100" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                </StackPanel>

                <!-- Password Input -->
                <TextBlock Name="Enter" Text="Enter your Password:" Foreground="#416788" HorizontalAlignment="Center"/>
                <Border Background="#E0E0E2" CornerRadius="8">
                    <TextBox x:Name="PasswordBox" Classes="revealPasswordButton" PasswordChar="•" Watermark="Enter your password" Width="250" VerticalContentAlignment="Center" Background="#E0E0E2" Foreground="#416788" TextChanged="PasswordBox_TextChanged" HorizontalAlignment="Center"/>
                </Border>

                <!-- Login Button -->
                <Button Name="LoginButton" Content="Login" Width="150" Height="30" Click="OnLoginClick" HorizontalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                <!-- Error Text -->
                <TextBlock x:Name="ErrorTextBlock" FontSize="12" Foreground="Red" Margin="0,5,0,0" IsVisible="False" HorizontalAlignment="Center"/>

                <!-- Forgot Password -->
                <Button Click="ForgotPasswordClick" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right">
                    <TextBlock Name="Forgot" Text="Forgot Passphrase?" Foreground="#416788" FontSize="12" TextDecorations="Underline"/>
                </Button>
            </StackPanel>

    </Grid>
</Window>
