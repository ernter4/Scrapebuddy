<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScrapeBuddy.ViewModels.CreatePassphraseWindow"
        Title="Create Passphrase"
        Width="500" Height="500"
        Icon="avares://ScrapeBuddy/Assets/logo.ico">
    
    <Window.Styles>
        <StyleInclude Source="../AppStyles.axaml"></StyleInclude>
    </Window.Styles>
    
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Enter Password:" Width="200" Margin="0,0,0,10"/>
        <TextBox x:Name="PasswordBox" Classes="revealPasswordButton" PasswordChar="*" Watermark="Enter your password" Width="200" Margin="0,0,0,5" TextChanged="PasswordBox_TextChanged"/>
        <TextBox x:Name="ConfirmPasswordBox" Classes="revealPasswordButton" PasswordChar="*" Watermark="Confirm your password" Width="200" Margin="0,0,0,10" TextChanged="Box_TextChanged"/>
        <TextBlock x:Name="ErrorTextBlock" FontSize="12" Foreground="Red" Margin="-1,10,0,0" IsVisible="False"/>
        <Button Content="Create New Password" Width="200" Click="OnCreateNewPasswordClick"/>
        
        <!-- Password Criteria -->
        <StackPanel Margin="-1,10,0,0" >
            <TextBlock x:Name="LengthCriteria" Text="✘ 8 characters long" Foreground="Red" FontSize="12"/>
            <TextBlock x:Name="UppercaseCriteria" Text="✘ 1 uppercase letter" Foreground="Red" FontSize="12"/>
            <TextBlock x:Name="LowercaseCriteria" Text="✘ 1 lowercase letter" Foreground="Red" FontSize="12"/>
            <TextBlock x:Name="DigitCriteria" Text="✘ 1 digit" Foreground="Red" FontSize="12"/>
            <TextBlock x:Name="SpecialCharCriteria" Text="✘ 1 special character" Foreground="Red" FontSize="12"/>
        </StackPanel>
    </StackPanel>
</Window>
