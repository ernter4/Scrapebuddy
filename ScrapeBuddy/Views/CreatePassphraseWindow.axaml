<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScrapeBuddy.ViewModels.CreatePassphraseWindow"
        Title="Create Passphrase"
        Width="400" Height="400"
        Icon="avares://ScrapeBuddy/Assets/logo.ico">
    
    <Window.Styles>
        <StyleInclude Source="../AppStyles.axaml"></StyleInclude>
    </Window.Styles>
    <Grid>

        <!-- Main Content -->

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="5">
                <TextBlock Name="EnterPW" Text="Create Your Secret Sauce!" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                    <Image Source="/Assets/logo.ico" Width="100" Height="100" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                </StackPanel>
                <TextBox x:Name="PasswordBox" Classes="revealPasswordButton" PasswordChar="*" Watermark="Enter passphrase" Width="200" Margin="0,0,0,5" TextChanged="PasswordBox_TextChanged" HorizontalAlignment="Center"/>
                <TextBox x:Name="ConfirmPasswordBox" Classes="revealPasswordButton" PasswordChar="*" Watermark="Confirm passphrase" Width="200" Margin="0,0,0,10" TextChanged="Box_TextChanged" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ErrorTextBlock" FontSize="12" Foreground="Red" Margin="-1,10,0,0" IsVisible="False" HorizontalAlignment="Center"/>
                <Button Name="CreateNew" Content="Create" Width="150" Height="30" Click="OnCreateNewPasswordClick" HorizontalAlignment="Center"/>

                <!-- Password Criteria -->
                <StackPanel Margin="-1,10,0,0" HorizontalAlignment="Center">
                    <TextBlock x:Name="LengthCriteria" Text="✘ 8 characters long" Foreground="Red" FontSize="12"/>
                    <TextBlock x:Name="UppercaseCriteria" Text="✘ 1 uppercase letter" Foreground="Red" FontSize="12"/>
                    <TextBlock x:Name="LowercaseCriteria" Text="✘ 1 lowercase letter" Foreground="Red" FontSize="12"/>
                    <TextBlock x:Name="DigitCriteria" Text="✘ 1 digit" Foreground="Red" FontSize="12"/>
                    <TextBlock x:Name="SpecialCharCriteria" Text="✘ 1 special character" Foreground="Red" FontSize="12"/>
                </StackPanel>
            </StackPanel>

    </Grid>
</Window>
