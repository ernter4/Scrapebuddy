<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Add Resources Here -->
    
    
    <!-- Buttoncolors -->
    <SolidColorBrush x:Key="ButtonDark" Color="#7A8B99"/>
    <SolidColorBrush x:Key="ButtonDarkHover" Color="#54626c"></SolidColorBrush>
    <SolidColorBrush x:Key="ButtonDarkPressed" Color="#586A77"></SolidColorBrush>
    <SolidColorBrush x:Key="ButtonDarkDisabled" Color="#b3bcc5"></SolidColorBrush>
    <SolidColorBrush x:Key="ButtonWhite" Color="#f5f5f7"/>
    <SolidColorBrush x:Key="ButtonWhiteHover" Color="#e3e1e1"></SolidColorBrush>
    <SolidColorBrush x:Key="ButtonWhitePressed" Color="#d8d5d5"></SolidColorBrush>
    <SolidColorBrush x:Key="ButtonWhiteDisabled" Color="#fcfcfd"></SolidColorBrush>
    
    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BackgroundLight" Color="#efefef"/> 
    <SolidColorBrush x:Key="BackgroundDark" Color="#282828"></SolidColorBrush>
    
    
</ResourceDictionary>
